{
  "name": "@hex64/core",
  "version": "1.2.0",
  "description": "Hex64 Universal Symbol Engine — a deterministic hexagram-based encoding infrastructure for AI feature encoding, DSL development, IoT control, and rule engine construction",
  "type": "module",
  "main": "src/core.js",
  "types": "src/core.d.ts",
  "exports": {
    ".": {
      "import": "./src/core.js",
      "types": "./src/core.d.ts"
    },
    "./database": {
      "import": "./src/database.js",
      "types": "./src/database.d.ts"
    },
    "./data": "./data/hex64_full.json"
  },
  "files": [
    "src/",
    "data/",
    "examples/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "hex64": "./bin/hex64.js"
  },
  "scripts": {
    "test": "node --test src/*.test.js",
    "demo": "node src/core.js"
  },
  "engines": {
    "node": ">=18"
  },
  "engine-strict": true,
  "keywords": ["hex64", "iching", "binary-encoding", "symbol-engine", "hexlang"],
  "license": "MIT",
  "author": "zjwjing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjwjing/HexLang.git"
  }
}
