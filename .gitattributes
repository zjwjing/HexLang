# Auto-detect text files and normalize to LF
* text=auto

# Explicitly set LF for source files
*.js text eol=lf
*.py text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.mjs text eol=lf

# Binary files - never normalize
*.png binary
*.jpg binary
*.ico binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
